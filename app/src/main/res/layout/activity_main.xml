<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header Status Shizuku -->
    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Status Shizuku: Memeriksa..."
        android:textSize="16sp"
        android:textStyle="bold"
        android:paddingBottom="12dp" />

    <!-- Navigation Tabs -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:tabMode="fixed"
        app:tabGravity="fill" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:paddingTop="12dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- TAB 1: DASHBOARD -->
            <LinearLayout
                android:id="@+id/tabDashboard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnQuickBoost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Quick Boost FPS" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchFastWifi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Fast Wi-Fi Scan Always Enabled" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchForceGpu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Force GPU Composition" />
            </LinearLayout>

            <!-- TAB 2: CONFIG -->
            <LinearLayout
                android:id="@+id/tabConfig"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="FPS Cap Limit (misal: 60, 90, 120)">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputFpsCap"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnApplyFpsCap"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Terapkan FPS Cap" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRes720p"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Set Resolusi ke 720p (HD)" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnResReset"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Reset Resolusi Default" />
            </LinearLayout>

            <!-- TAB 3: SCRIPT -->
            <LinearLayout
                android:id="@+id/tabScript"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Masukkan Perintah / Shell Script">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputCustomScript"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top"
                        android:inputType="textMultiLine"
                        android:minLines="4" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRunScript"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Jalankan Script via Shizuku" />
            </LinearLayout>

            <!-- TAB 4: SETTINGS -->
            <LinearLayout
                android:id="@+id/tabSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRecheckShizuku"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Cek Ulang Koneksi Shizuku" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnResetAll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Reset Semua Tweaks ke Default" />
            </LinearLayout>

        </FrameLayout>
    </ScrollView>

</LinearLayout>
